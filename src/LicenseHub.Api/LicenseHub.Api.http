### LicenseHub API examples (VS Code REST Client or Visual Studio).
### 1. Start the stack: docker compose up -d --build
### 2. Create a demo license: docker compose run --rm api seed
### 3. Paste the printed key below.
### Admin section: create an admin first with
###   docker compose run --rm api admin create --email you@example.com
### then set the email and password below and send the login request.

@baseUrl = http://localhost:8080
@key = LH-XXXX-XXXX-XXXX-XXXX
@productSlug = demo
@instanceId = local-server-01
@adminEmail = you@example.com
@adminPassword = your-admin-password
@token = {{login.response.body.$.accessToken}}

### Health
GET {{baseUrl}}/health

### Public key that verifies validation responses
GET {{baseUrl}}/v1/signing-key

### Validate (activates the instance on first use)
# The response payload is base64url JSON; decode it and verify the signature with the key above.
POST {{baseUrl}}/v1/licenses/validate
Content-Type: application/json

{
  "key": "{{key}}",
  "productSlug": "{{productSlug}}",
  "instanceId": "{{instanceId}}",
  "nonce": "{{$guid}}",
  "timestamp": {{$timestamp}}
}

### Validate from a second instance (counts against MaxActivations)
POST {{baseUrl}}/v1/licenses/validate
Content-Type: application/json

{
  "key": "{{key}}",
  "productSlug": "{{productSlug}}",
  "instanceId": "local-server-02",
  "nonce": "{{$guid}}",
  "timestamp": {{$timestamp}}
}

### Unknown key: 200 with valid=false and reason=unknown_key (still signed)
POST {{baseUrl}}/v1/licenses/validate
Content-Type: application/json

{
  "key": "LH-0000-0000-0000-0000",
  "productSlug": "{{productSlug}}",
  "instanceId": "{{instanceId}}",
  "nonce": "{{$guid}}",
  "timestamp": {{$timestamp}}
}

### Stale timestamp: 400 (request.timestamp_out_of_window)
POST {{baseUrl}}/v1/licenses/validate
Content-Type: application/json

{
  "key": "{{key}}",
  "productSlug": "{{productSlug}}",
  "instanceId": "{{instanceId}}",
  "nonce": "{{$guid}}",
  "timestamp": 1700000000
}

### Deactivate: 204, or 404 when the key or instance is not active
POST {{baseUrl}}/v1/licenses/deactivate
Content-Type: application/json

{
  "key": "{{key}}",
  "instanceId": "{{instanceId}}"
}

### OpenAPI document (Development only); the interactive UI is at {{baseUrl}}/scalar
GET {{baseUrl}}/openapi/v1.json

################################ Admin ################################

### Login: the requests below reuse its token (valid for 30 minutes)
# @name login
POST {{baseUrl}}/admin/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### Without a token: 401
GET {{baseUrl}}/admin/products

### Products
GET {{baseUrl}}/admin/products
Authorization: Bearer {{token}}

### Create a product
# @name createProduct
POST {{baseUrl}}/admin/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "FiveM Garage",
  "slug": "fivem-garage",
  "defaultMaxActivations": 2
}

### Change the name or default activation limit (the slug is immutable)
PATCH {{baseUrl}}/admin/products/{{createProduct.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "defaultMaxActivations": 3
}

### Issue a license: the key appears only in this response
# @name issueLicense
POST {{baseUrl}}/admin/licenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": "{{createProduct.response.body.$.id}}",
  "customerEmail": "buyer@example.com",
  "expiresAt": "2027-12-31T23:59:59Z"
}

### List licenses (status: active | revoked | expired; pageSize at most 100)
GET {{baseUrl}}/admin/licenses?status=active&productSlug=fivem-garage&page=1&pageSize=20
Authorization: Bearer {{token}}

### License details with activations (never the key)
GET {{baseUrl}}/admin/licenses/{{issueLicense.response.body.$.id}}
Authorization: Bearer {{token}}

### Revoke (idempotent: repeating keeps the first date, reason and admin)
POST {{baseUrl}}/admin/licenses/{{issueLicense.response.body.$.id}}/revoke
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "reason": "Chargeback"
}

### Free an activation slot
DELETE {{baseUrl}}/admin/licenses/{{issueLicense.response.body.$.id}}/activations/{{instanceId}}
Authorization: Bearer {{token}}

### Stats: licenses by status, validations per day (30 days), top products
GET {{baseUrl}}/admin/stats
Authorization: Bearer {{token}}
