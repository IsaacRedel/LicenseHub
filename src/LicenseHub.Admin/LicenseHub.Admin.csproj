<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Local settings for `dotnet run` (API URL, keys path); never committed. -->
    <UserSecretsId>licensehub-admin-3c9b1e72</UserSecretsId>
    <!-- The SDK adds the package with blazor.web.js only when it sees .razor files at restore time; the Dockerfile
         restores from the project file alone, so without this the published image has no _framework scripts. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads the claims of the API's token (sub, email) without validating it: the API just issued it. -->
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LicenseHub.Admin.Tests" />
  </ItemGroup>

</Project>
