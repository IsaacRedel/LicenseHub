@implements IAsyncDisposable
@inject IJSRuntime JS

@* Native <dialog> opened with showModal() (js/dialog.js): focus stays inside and Esc closes it. *@
<dialog @ref="_dialog" class="modal" aria-labelledby="@_titleId" @onclose="HandleClosedAsync">
    <h2 class="modal__title" id="@_titleId">@Title</h2>
    @ChildContent
</dialog>

@code {
    private readonly string _titleId = $"modal-{Guid.NewGuid():N}"[..14];
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool _shown;

    [Parameter]
    public bool Open { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Raised when the dialog closes, including with Esc.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Open == _shown)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dialog.js");
        await _module.InvokeVoidAsync(Open ? "open" : "close", _dialog);
        _shown = Open;
    }

    private async Task HandleClosedAsync()
    {
        _shown = false;
        if (Open)
        {
            await OnClose.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone; nothing to release in the browser.
            }
        }
    }
}
