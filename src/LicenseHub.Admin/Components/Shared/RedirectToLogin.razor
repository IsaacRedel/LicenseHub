@using LicenseHub.Admin.Auth
@inject NavigationManager Navigation

@code {
    /// <summary>Full reload to /login, so the static login page (and the cookie middleware) take over.</summary>
    protected override void OnInitialized()
    {
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"{AdminAuthentication.LoginPath}?ReturnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
