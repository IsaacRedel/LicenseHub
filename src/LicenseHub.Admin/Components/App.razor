@using LicenseHub.Admin.Theming
<!DOCTYPE html>
<html lang="pt-BR" data-theme="@_theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["css/theme.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["LicenseHub.Admin.styles.css"]" />
    @* No <ImportMap />: it renders an inline script, which the Content-Security-Policy (script-src 'self') blocks. *@
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" InitialTheme="@_theme" />
    <ReconnectModal />
    @* Shown by blazor.web.js when the circuit fails with an unhandled error, instead of a frozen page. *@
    <div id="blazor-error-ui" role="alert">
        Ocorreu um erro inesperado no painel.
        <a href="." class="reload">RECARREGAR</a>
    </div>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    /// <summary>
    /// Interactive Server without prerendering: API calls need the admin token, which only exists once the circuit
    /// opens (prerendering would also call the API twice). Pages marked [ExcludeFromInteractiveRouting], such as
    /// /login, stay static server-rendered.
    /// </summary>
    private static readonly IComponentRenderMode InteractiveServerWithoutPrerender = new InteractiveServerRenderMode(prerender: false);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Null (no data-theme) lets the CSS follow the system preference; a saved choice renders without flicker.
    private string? _theme;

    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServerWithoutPrerender : null;

    protected override void OnInitialized() =>
        _theme = Themes.FromCookie(HttpContext.Request.Cookies[Themes.CookieName]);
}
