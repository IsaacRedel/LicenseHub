# Copy this file to .env and replace the placeholder passwords.
# .env is git-ignored: never commit real secrets.
# Avoid ';' in passwords: they end up inside a connection string.

MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=licensehub
MARIADB_USER=licensehub
MARIADB_PASSWORD=change-me

# Private key that signs validation responses (single-line base64 PKCS#8).
# Generate one with: docker compose run --rm --no-deps api keygen
# Left empty, Development uses an ephemeral key that changes on every restart.
SIGNING_PRIVATE_KEY=

# HMAC key for admin tokens (base64, at least 256 bits), separate from the signing key above.
# keygen prints one too. Left empty, Development uses an ephemeral key (tokens stop working on restart).
ADMIN_JWT_KEY=

# Host ports, bound to 127.0.0.1 only. 3307 avoids clashing with a local MySQL/MariaDB on 3306.
MARIADB_PORT=3307
API_PORT=8080
